rules_version = '2';

// Forge Jean-Petit — who can see and change what.
// Only Gmail addresses listed in /members (plus the main admin) can get in.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isMainAdmin() {
      return signedIn() && myEmail() == 'gvercauteren@gmail.com';
    }
    function memberDoc() {
      return /databases/$(database)/documents/members/$(myEmail());
    }
    function isMember() {
      return signedIn() && (isMainAdmin() || exists(memberDoc()));
    }
    function isAdmin() {
      return isMainAdmin() || (isMember() && get(memberDoc()).data.admin == true);
    }
    function myFamily() {
      return get(memberDoc()).data.family;
    }

    function shortText(d, k, n) {
      return !(k in d) || (d[k] is string && d[k].size() <= n);
    }
    function isDate(v) {
      return v is string && v.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function validBooking(d) {
      return d.keys().hasOnly(['uid', 'email', 'name', 'family', 'start', 'end', 'note', 'guests', 'checklist', 'createdAt', 'updatedAt'])
        && d.uid is string && d.email is string && d.family is string
        && isDate(d.start) && isDate(d.end)
        && d.end >= d.start && d.end <= '2100-12-31'
        && shortText(d, 'name', 100) && shortText(d, 'createdAt', 40) && shortText(d, 'updatedAt', 40)
        && d.note is string && d.note.size() <= 500
        && (!('guests' in d) || (d.guests is int && d.guests >= 1 && d.guests <= 50))
        && (!('checklist' in d) || (d.checklist is map && d.checklist.size() <= 200));
    }

    // People allowed in. Document id = their Gmail address in lower case.
    match /members/{email} {
      allow get: if signedIn() && email == myEmail();
      allow read: if isMember();
      // Admins add and change people; only the main admin can make or remove admins.
      allow create, update: if isMainAdmin()
        || (isAdmin()
            && request.resource.data.admin == false
            && (resource == null || resource.data.admin == false));
      allow delete: if isMainAdmin() || (isAdmin() && resource.data.admin == false);
    }

    // Bookings: everyone in can see all of them; you change only your own; admins delete any.
    match /bookings/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && validBooking(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == myEmail()
        && (isAdmin() || request.resource.data.family == myFamily());
      allow update: if isMember() && validBooking(request.resource.data) && (
          (resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.email == resource.data.email
            && (isAdmin() || request.resource.data.family == myFamily()))
          // the booking's family can tick its exit checklist, even if someone else booked it
          || (resource.data.family == myFamily()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checklist', 'updatedAt'])));
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Tips nearby: everyone in reads and adds; you change your own; admins delete any.
    function validTip(d) {
      return d.keys().hasOnly(['uid', 'email', 'name', 'title', 'category', 'address', 'url', 'note', 'createdAt', 'updatedAt'])
        && d.uid is string && d.email is string
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && d.category in ['eat', 'shop', 'walk', 'sport', 'visit', 'kids', 'practical']
        && d.address is string && d.address.size() <= 300
        && d.url is string && d.url.size() <= 500
        && d.note is string && d.note.size() <= 1000
        && shortText(d, 'name', 100);
    }
    match /tips/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && validTip(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == myEmail();
      allow update: if isMember()
        && resource.data.uid == request.auth.uid
        && validTip(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Carnet, notes for the next family: everyone in reads and posts; anyone can mark a problem fixed;
    // only the author edits the text; the author or an admin deletes.
    function validNote(d) {
      return d.keys().hasOnly(['uid', 'email', 'name', 'text', 'kind', 'resolved', 'resolvedBy', 'resolvedAt', 'createdAt', 'updatedAt'])
        && d.uid is string && d.email is string
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 1000
        && d.kind in ['note', 'issue']
        && d.resolved is bool
        && shortText(d, 'name', 100) && shortText(d, 'resolvedBy', 200);
    }
    match /notes/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && validNote(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == myEmail()
        && request.resource.data.resolved == false;
      allow update: if isMember() && validNote(request.resource.data) && (
          (resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.email == resource.data.email)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedBy', 'resolvedAt']));
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Carnet, things to buy: everyone in reads, adds, ticks off and clears items.
    function validSupply(d) {
      return d.keys().hasOnly(['uid', 'email', 'name', 'text', 'done', 'doneBy', 'createdAt'])
        && d.uid is string && d.email is string
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 200
        && d.done is bool
        && shortText(d, 'name', 100) && shortText(d, 'doneBy', 200);
    }
    match /supplies/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && validSupply(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == myEmail()
        && request.resource.data.done == false;
      allow update: if isMember() && validSupply(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneBy']);
      allow delete: if isMember();
    }

    // Family names, exit checklist, contacts and house info: everyone reads, admins edit.
    match /config/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
  }
}
